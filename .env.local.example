# Copy to .env.local (gitignored). Paper is the default.

# Trading wallet — CLI (`polymarket wallet create`) or py-sdk.
# Fund the deposit wallet (funder), not the signer EOA.
POLYGON_PRIVATE_KEY=""
POLYMARKET_PRIVATE_KEY=""
POLYMARKET_FUNDER_ADDRESS=""
POLYMARKET_SIGNER_ADDRESS=""

# Live CLOB stays off until the funder is funded AND you opt in.
LIVE_TRADING="false"
PAPER_TRADE="true"

# Path-ensemble paper candidate (SPEC-path-ensemble.md). 3¢ after fee.
POLYAGENT_PATH_EDGE="0.03"
# POLYAGENT_PRICE_MIN_VOLUME_24H="8000"

# Optional later: only judge() should call this.
XAI_API_KEY=""
